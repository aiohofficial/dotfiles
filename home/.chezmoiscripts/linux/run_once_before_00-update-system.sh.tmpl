#!/usr/bin/env bash
set -eufo pipefail

sudo apt-get update
sudo apt-get upgrade -y
# build-essential/bubblewrap - Homebrew's own recommended dependencies;
# unzip - needed by brew cask installs (e.g. tflint).
sudo apt-get install -y build-essential bubblewrap unzip locales

# en_US.UTF-8 is not generated by default - dot_zshrc sets LANG to it,
# and without generation every locale-aware tool (perl, etc.) falls back
# to C with a warning on every single invocation.
sudo locale-gen en_US.UTF-8
sudo update-locale LANG=en_US.UTF-8
